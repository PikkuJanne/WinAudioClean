    "sanitized_source": "from pathlib import Path\nimport concurrent.futures,hashlib,json,os,re,shutil,subprocess,sys,time\nroot=Path.cwd(); scratch=root/'.wac-local/WAC-M3-03'; evidence=root/'docs/codex/winaudioclean/evidence'\nphase=sys.argv[1]; label=sys.argv[2] if len(sys.argv)>2 else 'final'\nassert phase in ('Targeted','Full') and re.fullmatch('[a-z0-9-]+',label)\nnames=subprocess.check_output(['git','ls-files','--cached','--others','--exclude-standard'],text=True).splitlines()\nnames=sorted(set(n for n in names if n.endswith(('.ps1','.psd1','.py','.cs','.bat')) and (root/n).is_file()))\nsha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()\nsource={n:sha(root/n) for n in names}\ndef sanitize(text):\n text=re.sub(r'\\x1b\\[[0-?]*[ -/]*[@-~]','',text)\n for old,new in ((str(root),'<repo>'),(root.as_posix(),'<repo>'),(str(Path.home()),'<user-profile>'),(Path.home().as_posix(),'<user-profile>')):\n  pattern=r'[\\\\/]+'.join(re.escape(part) for part in re.split(r'[\\\\/]+',old))\n  text=re.sub(pattern,lambda m:new,text,flags=re.I)\n return '\\n'.join(line.rstrip() for line in text.splitlines()).rstrip()+'\\n'\ndef run(shell):\n exe=shutil.which(shell);assert exe\n host='ps51' if shell=='powershell.exe' else 'ps7'\n statement='./scripts/Invoke-Tests.ps1 -Level '+phase\n if phase=='Targeted': statement+=\" -Path @('tests/WinAudioClean.FolderQueue.Tests.ps1','tests/WinAudioClean.Batch.Tests.ps1')\"\n if phase=='Full' and host=='ps7':statement+=' -AnalyzerWarnings'\n command=[exe,'-NoLogo','-NoProfile','-ExecutionPolicy','Bypass','-Command',statement]\n env={k:v for k,v in os.environ.items() if k.upper()!='PSMODULEPATH'};start=time.time()\n p=subprocess.run(command,env=env,cwd=root,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,encoding='utf-8',errors='replace',timeout=2400)\n log=evidence/('WAC-M3-03-'+phase.lower()+'-'+label+'-'+host+'.txt')\n assert not log.exists(),'Refusing to overwrite prior gate evidence.'\n log.write_text(sanitize(p.stdout),encoding='utf-8',newline='\\n')\n r={'shell':host,'phase':phase,'label':label,'command':[sanitize(a).strip() for a in command],'exit_code':p.returncode,'elapsed_seconds':round(time.time()-start,2),'log':log.relative_to(evidence.parent).as_posix(),'log_sha256':sha(log)}\n print(json.dumps(r),flush=True);print('\\n'.join(sanitize(p.stdout).splitlines()[-10:]),flush=True);return r\nwith concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:runs=list(pool.map(run,['powershell.exe','pwsh.exe']))\nunchanged=source=={n:sha(root/n) for n in names}\nmetadata=scratch/(phase.lower()+'-'+label+'-results.json');assert not metadata.exists()\nmetadata.write_text(json.dumps({'source':source,'source_unchanged':unchanged,'runs':runs},indent=2)+'\\n',encoding='utf-8')\nraise SystemExit(0 if unchanged and all(r['exit_code']==0 for r in runs) else 1)\n"
