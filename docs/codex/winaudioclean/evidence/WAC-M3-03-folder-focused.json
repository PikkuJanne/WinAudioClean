    "text": "param([string]$Repository, [string]$Tag = 'Unit')\r\n$ErrorActionPreference = 'Stop'\r\nImport-Module (Join-Path $Repository '.wac-local/Modules/Pester/5.7.1/Pester.psd1') -Force\r\nWrite-Output ('Focused shell: ' + $PSVersionTable.PSVersion)\r\n$result = Invoke-Pester -Path (Join-Path $Repository 'tests/WinAudioClean.FolderQueue.Tests.ps1') -TagFilter $Tag -Output Detailed -PassThru\r\nif ($result.PassedCount -eq 0 -or $result.FailedCount -gt 0 -or $result.FailedContainersCount -gt 0 -or $result.FailedBlocksCount -gt 0) { exit 1 }\r\nexit 0\r\n",
