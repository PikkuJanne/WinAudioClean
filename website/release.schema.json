{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WinAudioClean static release metadata, version 1",
  "description": "Schema validation does not establish publication or artifact identity. The local validator also verifies source, package manifest, provenance and checksum before accepting published metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "application", "status", "version", "date", "download", "source", "requirements"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "application": {"type": "string", "const": "WinAudioClean"},
    "status": {"type": "string", "enum": ["draft", "published"]},
    "version": {"type": "string", "maxLength": 32, "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+){0,2}$"},
    "date": {"type": ["null", "string"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "fileName", "sha256", "bytes"],
      "properties": {
        "url": {"type": ["null", "string"], "maxLength": 512, "pattern": "^(?:https://github\\.com/PikkuJanne/WinAudioClean/releases/download/[A-Za-z0-9][A-Za-z0-9._-]*/)?WinAudioClean-[0-9]+\\.[0-9]+(?:\\.[0-9]+){0,2}-[0-9a-f]{12}-tool-only\\.zip$"},
        "fileName": {"type": ["null", "string"], "pattern": "^WinAudioClean-[0-9]+\\.[0-9]+(?:\\.[0-9]+){0,2}-[0-9a-f]{12}-tool-only\\.zip$"},
        "sha256": {"type": ["null", "string"], "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": ["null", "integer"], "minimum": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": {"type": ["null", "string"], "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": ["null", "string"], "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platforms", "powershell", "ffmpeg", "installation", "privacy"],
      "properties": {
        "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "powershell": {"type": "array", "const": ["5.1", "7"]},
        "ffmpeg": {"type": "string", "minLength": 1},
        "installation": {"type": "string", "minLength": 1},
        "privacy": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "draft"}}},
      "then": {
        "properties": {
          "date": {"type": "null"},
          "download": {"properties": {"url": {"type": "null"}, "fileName": {"type": "null"}, "sha256": {"type": "null"}, "bytes": {"type": "null"}}},
          "source": {"properties": {"commit": {"type": "null"}, "tree": {"type": "null"}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "published"}}},
      "then": {
        "properties": {
          "date": {"type": "string"},
          "download": {"properties": {"url": {"type": "string", "minLength": 1}, "fileName": {"type": "string"}, "sha256": {"type": "string"}, "bytes": {"type": "integer"}}},
          "source": {"properties": {"commit": {"type": "string"}, "tree": {"type": "string"}}}
        }
      }
    }
  ]
}
